NODE_ENV=development
PORT=8080
# For automated tests, copy .env.test (see tests/setup/testEnv.js)
MONGODB_URI=mongodb://localhost:27017/employee-management
CLIENT_URL=http://localhost:3000

JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP) — start Redis first: docker compose up -d redis
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=SuperTex Mills
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_USER=
SMTP_PASS=

# OTP security — min 32 chars; required in production
OTP_PEPPER=change-me-to-a-random-string-at-least-32-chars

# Redis (required in production for async email queue)
REDIS_URL=redis://127.0.0.1:6379

SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# RFID / factory settings are managed in the FactorySettings DB collection (admin dashboard).
# These four vars are only used on the very first boot to create the initial DB document.
# After first boot you can safely remove them.
RFID_ENABLED=false
FACTORY_TIMEZONE=Asia/Kolkata
DEFAULT_MIN_ROUND_INTERVAL_SECONDS=30
COUNT_OUTSIDE_SHIFT=false
