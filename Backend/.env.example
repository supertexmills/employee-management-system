NODE_ENV=development
PORT=8080
# For automated tests, copy .env.test (see tests/setup/testEnv.js)
MONGODB_URI=mongodb://localhost:27017/employee-management
CLIENT_URL=http://localhost:3000

JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

RFID_ENABLED=false
RFID_READER_IP=192.168.1.200
RFID_READER_PORT=200
RFID_READER_ID=MILL_01_READER
RFID_LOCATION=Spinning Mill 1
RFID_READER_POLL_MS=500
FACTORY_TIMEZONE=Asia/Kolkata
DEFAULT_MIN_ROUND_INTERVAL_SECONDS=30
COUNT_OUTSIDE_SHIFT=false
