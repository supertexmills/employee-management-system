RFID_ENABLED=false
RFID_READER_IP=192.168.1.200
RFID_READER_PORT=200
RFID_READER_ID=GATE_1
RFID_LOCATION=Main Gate
RFID_READER_POLL_MS=500
RFID_DUPLICATE_MS=2000
RFID_ANTI_PASSBACK_MS=30000
FACTORY_TIMEZONE=Asia/Kolkata
MISSING_TAG_THRESHOLD_MINUTES=90
